<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Inova RS Serra · Observatório de Inovação</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg:#f5f5f3; --surface:#fff; --surface2:#f0f0ee;
  --border:rgba(0,0,0,.10); --border-lt:rgba(0,0,0,.06);
  --text:#1a1a18; --text2:#555552; --text3:#888780;
  --green:#2d6b14; --red:#9b2335; --yellow:#b8860b;
  --blue:#1a6eb5; --r-md:10px; --r-lg:14px;
}
[data-dark="1"] {
  --bg:#0e0e0e; --surface:#1a1a1a; --surface2:#242424;
  --border:rgba(255,255,255,.10); --border-lt:rgba(255,255,255,.06);
  --text:#f0f0ee; --text2:#aaa9a5; --text3:#666460;
}
body { font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
       background:var(--bg); color:var(--text); font-size:16px; line-height:1.55;
       transition:background .25s,color .25s; }

/* CAPA */
#capa { min-height:100vh; background:#fff; display:flex; flex-direction:column; }
.capa-header {
  background:linear-gradient(90deg,#9b2335 0%,#b53040 30%,#7ab030 70%,#4a8c2a 100%);
  padding:28px 40px; text-align:center;
}
.capa-titulo { font-size:36px; font-weight:900; color:#fff; letter-spacing:.5px; text-transform:uppercase; }
.capa-body { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px 60px; gap:36px; }
.capa-btns { display:flex; gap:16px; width:100%; max-width:960px; flex-wrap:wrap; }
.capa-btn {
  flex:1; min-width:200px; display:flex; align-items:center; justify-content:center;
  padding:26px 20px; border-radius:12px; border:none; cursor:pointer;
  font-size:18px; font-weight:900; color:#fff; letter-spacing:.5px; text-transform:uppercase;
  transition:transform .15s,filter .15s; box-shadow:0 3px 12px rgba(0,0,0,.18);
}
.capa-btn:hover { transform:translateY(-2px); filter:brightness(1.08); }
.capa-btn.verde { background:#2d6b14; }
.capa-btn.verm  { background:#9b2335; }
.capa-btn.amare { background:#b8860b; }
.capa-texto { max-width:800px; font-size:16px; line-height:1.75; color:#444; text-align:center; }
.capa-logos { display:flex; align-items:center; justify-content:center; gap:60px; flex-wrap:wrap; }
.capa-rodape { padding:14px; font-size:12px; color:#aaa; text-align:center; }

/* CARROSSEL */
.capa-bg { position:absolute; inset:0; z-index:0; }
.capa-bg-slide {
  position:absolute; inset:0;
  background-size:cover; background-position:center;
  opacity:0; transition:opacity 1.4s ease-in-out;
}
.capa-bg-slide.ativo { opacity:1; }
#capa { position:relative; overflow:hidden; }
.capa-overlay { position:absolute; inset:0; background:rgba(255,255,255,0.62); z-index:1; }
.capa-body, .capa-header, .capa-rodape { position:relative; z-index:2; }

/* PAINEL */
#painel { display:none; }
.header { background:linear-gradient(90deg,#9b2335 0%,#b53040 25%,#b8860b 55%,#7ab030 80%,#2d6b14 100%);
          border-bottom:none; padding:14px 28px;
          display:flex; align-items:center; justify-content:space-between; gap:12px;
          flex-wrap:wrap; position:sticky; top:0; z-index:100;
          box-shadow:0 2px 8px rgba(0,0,0,.25); }
.header-title { font-size:18px; font-weight:900; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.3); }
.header-sub   { font-size:13px; color:rgba(255,255,255,.80); margin-top:2px; }
.header-right { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
.header-right select { font-size:14px; padding:7px 12px; border-radius:var(--r-md);
  border:none; background:#f5f0e8; color:#1a1a18; min-width:150px;
  font-weight:600; }
.header-right select option { background:#f5f0e8; color:#1a1a18; }
.btn-ctrl { padding:7px 14px; border-radius:var(--r-md); border:1px solid rgba(255,255,255,.35);
  background:rgba(255,255,255,.18); color:#fff; font-size:14px; cursor:pointer;
  font-weight:600; backdrop-filter:blur(4px); }
.btn-ctrl:hover { background:rgba(255,255,255,.30); }

.nav { background:var(--surface); border-bottom:.5px solid var(--border); padding:0 28px; display:flex; }
.nav-tab { padding:14px 22px; font-size:15px; font-weight:600; cursor:pointer; background:none;
  border:none; border-bottom:3px solid transparent; color:var(--text2); margin-bottom:-.5px; }
.nav-tab:hover { color:var(--text); }
.nav-tab.verde.on { color:var(--green); border-bottom-color:var(--green); }
.nav-tab.verm.on  { color:var(--red);   border-bottom-color:var(--red); }
.nav-tab.amare.on { color:var(--yellow);border-bottom-color:var(--yellow); }

.main { padding:24px 28px; max-width:1280px; margin:0 auto; }
.tab-content { display:none; }
.tab-content.on { display:block; }

.loading { display:flex; align-items:center; justify-content:center;
  padding:80px 0; flex-direction:column; gap:14px; color:var(--text2); font-size:16px; }
.spinner { width:36px; height:36px; border:3px solid var(--border);
  border-top-color:var(--blue); border-radius:50%; animation:spin .7s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* KPI coloridos */
.kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:22px; }
.kpi { border-radius:var(--r-lg); padding:20px 22px; border-left:5px solid; }
.kpi-a { background:#e8f4fd; border-color:#1a6eb5; }
.kpi-m { background:#f0fae8; border-color:#2d6b14; }
.kpi-p { background:#fff5e6; border-color:#d46c1a; }
.kpi-e { background:#f4eeff; border-color:#6a4ab5; }
[data-dark="1"] .kpi-a { background:#0d2a40; }
[data-dark="1"] .kpi-m { background:#0f2a0a; }
[data-dark="1"] .kpi-p { background:#2d1a00; }
[data-dark="1"] .kpi-e { background:#1a1030; }
.kpi-label { font-size:13px; font-weight:700; color:var(--text2); margin-bottom:6px; text-transform:uppercase; letter-spacing:.5px; }
.kpi-value { font-size:32px; font-weight:900; }
.kpi-a .kpi-value { color:#1a6eb5; }
.kpi-m .kpi-value { color:#2d6b14; }
.kpi-p .kpi-value { color:#d46c1a; }
.kpi-e .kpi-value { color:#6a4ab5; }
.kpi-sub   { font-size:13px; color:var(--text3); margin-top:4px; font-weight:500; }

.card { background:var(--surface); border:.5px solid var(--border-lt);
  border-radius:var(--r-lg); padding:20px 22px; margin-bottom:14px; }
.card-title { font-size:15px; font-weight:700; margin-bottom:16px; }
.grid-2    { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px; }
.grid-left { display:grid; grid-template-columns:1.4fr 1fr; gap:14px; margin-bottom:14px; }

.badge { display:inline-block; padding:3px 10px; border-radius:99px;
  font-size:12px; font-weight:700; white-space:nowrap; }
.badge-green  { background:#e5f3d8; color:#2d6010; }
.badge-amber  { background:#faeeda; color:#7a4d00; }
.badge-blue   { background:#ddeeff; color:#1a6eb5; }
.badge-purple { background:#eeedfe; color:#3c3489; }
.badge-gray   { background:var(--surface2); color:var(--text2); }
.badge-teal   { background:#d4f5ee; color:#0d6b56; }
.badge-rose   { background:#fde8f0; color:#8a1a40; }

.tbl-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:14px; }
th { font-weight:700; font-size:13px; color:var(--text2); text-align:left;
  padding:10px 12px; border-bottom:.5px solid var(--border); background:var(--surface2);
  text-transform:uppercase; letter-spacing:.4px; }
td { padding:10px 12px; border-bottom:.5px solid var(--border-lt); vertical-align:middle; }
tr:last-child td { border-bottom:none; }
tr:hover td { background:var(--surface2); }
td.muted { color:var(--text2); font-size:13px; }

.cnt { font-size:13px; color:var(--text3); text-align:right; margin-bottom:10px; font-weight:600; }

.hbar-row { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
.hbar-lbl { font-size:13px; font-weight:600; color:var(--text2); width:180px; flex-shrink:0;
  text-align:right; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.hbar-track { flex:1; height:26px; background:var(--surface2); border-radius:5px; overflow:hidden; }
.hbar-fill { height:100%; border-radius:5px; display:flex; align-items:center; padding:0 10px; min-width:32px; }
.hbar-num { font-size:13px; color:#fff; font-weight:800; }

.empty { text-align:center; padding:40px; color:var(--text3); font-size:15px; }
.erro-box { background:#fde8ec; border:1px solid #f5bcc6; border-radius:var(--r-lg);
  padding:28px 32px; text-align:center; color:#7a1a28; font-size:15px; line-height:1.8; }
.erro-box strong { display:block; font-size:17px; margin-bottom:10px; }
.erro-box code { background:#f5bcc6; padding:2px 6px; border-radius:4px; font-family:monospace; }

/* badge ecossistema com cor dinâmica */
.eco-badge { display:inline-block; padding:3px 10px; border-radius:99px;
  font-size:12px; font-weight:700; color:#fff; white-space:nowrap; }

@media (max-width:750px) {
  .kpi-grid { grid-template-columns:repeat(2,1fr); }
  .grid-2,.grid-left { grid-template-columns:1fr; }
  .main { padding:14px; }
  .capa-titulo { font-size:26px; }
  .capa-btn { font-size:15px; padding:20px; }
  .capa-body { padding:24px 16px; }
}
</style>
</head>
<body>

<!-- CAPA -->
<section id="capa">
  <!-- Carrossel de fundo -->
  <div class="capa-bg" id="capa-bg"></div>
  <div class="capa-overlay"></div>
  <div class="capa-header">
    <h1 class="capa-titulo">Ecossistemas de Inovação – Serra Gaúcha</h1>
  </div>
  <div class="capa-body">
    <div class="capa-btns">
      <button class="capa-btn verde" onclick="abrirPainel('visao')">VISÃO GERAL</button>
      <button class="capa-btn verm"  onclick="abrirPainel('atores')">ATORES DE INOVAÇÃO</button>
      <button class="capa-btn amare" onclick="abrirPainel('projetos')">PROJETOS E INICIATIVAS</button>
    </div>
    <p class="capa-texto">
      O <strong>Inova RS Serra</strong> é o ecossistema de inovação da Serra Gaúcha.
      Com foco no mapeamento e fortalecimento dos atores regionais, o observatório reúne dados
      sobre iniciativas, projetos e organizações que impulsionam o desenvolvimento econômico e social da região.
      A iniciativa integra a <strong>Rede RS de Ecossistemas de Inovação</strong>, coordenada pela
      Secretaria de Inovação, Ciência e Tecnologia do RS.
    </p>
    <div class="capa-logos">
      <svg viewBox="0 0 240 80" xmlns="http://www.w3.org/2000/svg" width="190">
        <text x="8" y="54" font-family="Arial Black,sans-serif" font-weight="900" font-size="42" fill="#555">.INOVA</text>
        <text x="150" y="54" font-family="Arial Black,sans-serif" font-weight="900" font-size="42" fill="#555">RS</text>
        <path d="M224 62 A30 30 0 0 1 224 10" stroke="#4a8c2a" stroke-width="5" fill="none" stroke-linecap="round"/>
        <path d="M217 57 A23 23 0 0 1 217 15" stroke="#9b2335" stroke-width="5" fill="none" stroke-linecap="round"/>
        <path d="M210 52 A16 16 0 0 1 210 20" stroke="#b8860b" stroke-width="5" fill="none" stroke-linecap="round"/>
      </svg>
      <div style="width:1px;height:60px;background:#ddd;"></div>
      <svg viewBox="0 0 270 80" xmlns="http://www.w3.org/2000/svg" width="210">
        <ellipse cx="28" cy="20" rx="10" ry="13" fill="#4a8c2a"/>
        <rect x="18" y="33" width="20" height="26" rx="10" fill="#4a8c2a"/>
        <ellipse cx="46" cy="18" rx="10" ry="13" fill="#9b2335"/>
        <rect x="36" y="31" width="20" height="28" rx="10" fill="#9b2335"/>
        <ellipse cx="64" cy="20" rx="10" ry="13" fill="#b8860b"/>
        <rect x="54" y="33" width="20" height="26" rx="10" fill="#b8860b"/>
        <text x="90" y="22" font-family="Arial,sans-serif" font-size="9" fill="#777">GOVERNO DO ESTADO</text>
        <text x="90" y="40" font-family="Arial Black,sans-serif" font-size="14" fill="#222" font-weight="900">RIO GRANDE DO SUL</text>
        <text x="90" y="56" font-family="Arial,sans-serif" font-size="8" fill="#888">SECRETARIA DE INOVAÇÃO,</text>
        <text x="90" y="68" font-family="Arial,sans-serif" font-size="8" fill="#888">CIÊNCIA E TECNOLOGIA</text>
      </svg>
    </div>
  </div>
  <div class="capa-rodape">Dados atualizados via Google Sheets</div>
</section>

<!-- PAINEL -->
<div id="painel">
  <header class="header">
    <div>
      <div class="header-title">Inova RS Serra</div>
      <div class="header-sub">Observatório de Inovação · <span id="txt-atualizado">carregando...</span></div>
    </div>
    <div class="header-right">
      <select id="sel-cidade" onchange="aplicarFiltros()"><option value="">Todos os municípios</option></select>
      <select id="sel-eco"    onchange="aplicarFiltros()"><option value="">Todos os ecossistemas</option></select>
      <select id="sel-ano"    onchange="aplicarFiltros()"><option value="">Todos os anos</option></select>
      <button class="btn-ctrl" onclick="toggleDark()" id="btn-dark">🌙 Escuro</button>
      <button class="btn-ctrl" onclick="voltarCapa()">← Voltar</button>
    </div>
  </header>
  <nav class="nav">
    <button class="nav-tab verde on" onclick="abaTab('visao',this)">📊 Visão Geral</button>
    <button class="nav-tab verm"     onclick="abaTab('atores',this)">🏢 Atores de Inovação</button>
    <button class="nav-tab amare"    onclick="abaTab('projetos',this)">🚀 Projetos &amp; Iniciativas</button>
  </nav>
  <main class="main">

    <!-- VISAO GERAL -->
    <div id="tab-visao" class="tab-content on">
      <div id="load-visao" class="loading"><div class="spinner"></div><span>Buscando dados...</span></div>
      <div id="content-visao" style="display:none;">
        <div class="kpi-grid">
          <div class="kpi kpi-a"><div class="kpi-label">Atores Mapeados</div><div class="kpi-value" id="k-atores">0</div><div class="kpi-sub" id="k-atores-sub"></div></div>
          <div class="kpi kpi-m"><div class="kpi-label">Municípios</div><div class="kpi-value" id="k-munis">0</div><div class="kpi-sub" id="k-munis-sub"></div></div>
          <div class="kpi kpi-p"><div class="kpi-label">Projetos</div><div class="kpi-value" id="k-proj">0</div><div class="kpi-sub" id="k-proj-sub"></div></div>
          <div class="kpi kpi-e"><div class="kpi-label">Ecossistemas</div><div class="kpi-value" id="k-ecos">0</div><div class="kpi-sub" id="k-ecos-sub"></div></div>
        </div>
        <div class="grid-left">
          <div class="card"><div class="card-title">Atores por tipo de organização</div><div style="position:relative;height:220px;"><canvas id="c-tipos"></canvas></div></div>
          <div class="card"><div class="card-title">Atores por área</div><div style="position:relative;height:220px;"><canvas id="c-areas-at"></canvas></div></div>
        </div>

        <div class="card"><div class="card-title">Atores por ecossistema</div><div id="hbars-ecos"></div></div>
        <div class="card"><div class="card-title">Top municípios com mais atores</div><div id="hbars-cidades"></div></div>
        <div class="card" style="padding:0;overflow:hidden;">
          <!-- Barra verde musgo -->
          <div style="background:#1a3d1a;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <button onclick="toggleVocacoesTexto()" style="background:#f5f0e8;border:none;cursor:pointer;padding:8px 16px;border-radius:6px;font-size:14px;font-weight:700;color:#1a3d1a;display:flex;align-items:center;gap:8px;letter-spacing:.3px;">
              Vocações da Região Serra Gaúcha
              <span id="venn-arrow" style="font-size:11px;transition:transform .25s;">▼</span>
            </button>
            <select id="sel-venn-cidade" onchange="renderVennCidade()" style="font-size:14px;padding:7px 14px;border-radius:6px;border:none;background:#f5f0e8;color:#1a3d1a;font-weight:600;min-width:180px;cursor:pointer;">
              <option value="">Todos os municípios</option>
            </select>
          </div>
          <!-- Texto explicativo (dropdown) -->
          <div id="vocacoes-texto" style="display:none;background:#f0ece0;padding:22px 28px;border-bottom:1px solid #d0c8a8;">
            <h3 style="font-size:16px;font-weight:800;color:#1a3d1a;margin-bottom:14px;">Vocações da Região Serra Gaúcha</h3>
            <p style="font-size:14px;line-height:1.75;color:#333;margin-bottom:12px;">A Serra Gaúcha é uma das regiões mais dinâmicas e diversificadas do Brasil, reconhecida tanto pela força de sua base industrial quanto pelo potencial turístico e pela capacidade de inovação. No âmbito do projeto Inova RS, o mapeamento das vocações regionais foi estruturado a partir de quatro eixos estratégicos — <strong>Indústria 4.0, Cidades Inteligentes, Turismo e Educação Tecnológica</strong> — que se integram e se potencializam mutuamente, formando um ecossistema único de desenvolvimento territorial.</p>
            <p style="font-size:14px;line-height:1.75;color:#333;margin-bottom:12px;">O eixo da <strong>Indústria 4.0</strong> abrange setores consolidados como metalmecânica, eletroeletrônica, automotivo, moveleiro, têxtil e de plásticos e polímeros, aos quais se somam segmentos emergentes como a economia criativa e a agricultura tecnológica. Já o eixo de <strong>Cidades Inteligentes</strong> conecta essas forças produtivas a uma visão de futuro sustentável, com iniciativas voltadas à resiliência climática, à sustentabilidade ambiental e ao fortalecimento da cultura e da comunidade local.</p>
            <p style="font-size:14px;line-height:1.75;color:#333;margin-bottom:12px;">O <strong>Turismo</strong> representa uma vocação histórica da região, expressa em suas vertentes enológica, gastronômica, ecológica, rural, esportiva e de experiência, que atraem visitantes nacionais e internacionais ao longo de todo o ano.</p>
            <p style="font-size:14px;line-height:1.75;color:#333;">Transversal a todos esses eixos, a <strong>Educação Tecnológica</strong> atua como base estruturante do desenvolvimento regional. Iniciativas de educação empreendedora, pesquisa científica, capacitação profissional contínua, robótica e mecatrônica formam o capital humano necessário para que a Serra Gaúcha avance rumo a uma economia de alto valor agregado. É na convergência entre indústria avançada, turismo qualificado, cidades inteligentes e educação de excelência que residem as maiores oportunidades de inovação, geração de emprego e melhoria da qualidade de vida para todos os cidadãos da Serra Gaúcha.</p>
          </div>
          <!-- Diagrama -->
          <div style="padding:20px 22px;">
            <div style="display:flex;justify-content:center;"><div id="venn-container"></div></div>
            <div style="margin-top:14px;display:flex;gap:24px;justify-content:center;flex-wrap:wrap;font-size:13px;font-weight:600;">
              <span style="color:#2196B3;">⬤ Indústria 4.0</span>
              <span style="color:#E53935;">⬤ Turismo</span>
              <span style="color:#43A047;">⬤ Educação Tecnológica</span>
            </div>
            <p style="margin-top:10px;font-size:12px;color:var(--text3);text-align:center;">Classificação automática baseada no segmento de cada ator</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ATORES -->
    <div id="tab-atores" class="tab-content">
      <div id="load-atores" class="loading"><div class="spinner"></div><span>Aguardando dados...</span></div>
      <div id="content-atores" style="display:none;">
        <div class="card" style="padding:0;overflow:hidden;">
          <div style="background:#b8860b;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <span style="font-size:20px;font-weight:900;color:#fff;letter-spacing:.4px;text-transform:uppercase;">Atores de Inovação Cadastrados</span>
            <span id="cnt-atores" style="background:rgba(255,255,255,0.2);color:#fff;font-size:14px;font-weight:700;padding:5px 14px;border-radius:20px;">0 registros</span>
          </div>
          <div style="padding:20px 22px;">
            <div class="tbl-wrap">
              <table><thead><tr><th>#</th><th>Empresa / Organização</th><th>Tipo</th><th>Município</th><th>Ecossistema</th></tr></thead>
              <tbody id="tbody-atores"></tbody></table>
              <div id="empty-atores" class="empty" style="display:none;">Nenhum resultado.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PROJETOS -->
    <div id="tab-projetos" class="tab-content">
      <div id="load-proj" class="loading"><div class="spinner"></div><span>Aguardando dados...</span></div>
      <div id="content-proj" style="display:none;">
        <div class="card" style="padding:0;overflow:hidden;">
          <div style="background:#9b2335;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <span style="font-size:20px;font-weight:900;color:#fff;letter-spacing:.4px;text-transform:uppercase;">Projetos &amp; Iniciativas de Inovação</span>
            <span id="cnt-proj" style="background:rgba(255,255,255,0.2);color:#fff;font-size:14px;font-weight:700;padding:5px 14px;border-radius:20px;">0 registros</span>
          </div>
          <div style="padding:20px 22px;">
            <div class="tbl-wrap">
              <table><thead><tr><th>#</th><th>Nome do projeto</th><th>Proponente</th><th>Área</th><th>Estágio</th><th>Município</th><th>Data</th></tr></thead>
              <tbody id="tbody-proj"></tbody></table>
              <div id="empty-proj" class="empty" style="display:none;">Nenhum resultado.</div>
            </div>
          </div>
        </div>
        <div class="grid-2" id="proj-charts-grid" style="margin-top:14px;">
          <div class="card"><div class="card-title">Projetos por área temática</div><div style="position:relative;height:220px;"><canvas id="c-areas-proj"></canvas></div></div>
          <div class="card"><div class="card-title">Projetos por estágio</div><div style="position:relative;height:220px;"><canvas id="c-estagios"></canvas></div></div>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
var DADOS = null, CHARTS = {}, DARK = false;
var CORES = ['#1a6eb5','#1d9e75','#d4a017','#9b2335','#6a4ab5','#d46c1a','#2a8c6e','#c94580','#4a7fa5','#c44'];

// Mapa de cores por ecossistema (dinâmico)
var ECO_CORES = {};
var PALETA_ECO = ['#1a6eb5','#1d9e75','#9b2335','#d46c1a','#6a4ab5','#d4a017','#2a8c6e','#c94580','#0d7a7a','#8b5a00','#4a5e8a','#a0522d'];

function corEco(nome) {
  if (!ECO_CORES[nome]) {
    var idx = Object.keys(ECO_CORES).length;
    ECO_CORES[nome] = PALETA_ECO[idx % PALETA_ECO.length];
  }
  return ECO_CORES[nome];
}

/* ============================================================
   INIT
   ============================================================ */
window.onload = function() {
  if (typeof google !== 'undefined' && google.script) {
    var timer = setTimeout(function() {
      mostrarErro(
        '<strong>Tempo limite atingido (30s).</strong><br><br>' +
        'No editor do Apps Script, selecione <code>getDados</code> e clique em <strong>Executar ▶</strong>. ' +
        'Aprove as permissões e faça um novo deploy.'
      );
    }, 30000);
    google.script.run
      .withSuccessHandler(function(dados) {
        clearTimeout(timer);
        if (!dados) { mostrarErro('Servidor retornou resposta vazia.'); return; }
        if (dados.erro) { mostrarErro('Erro no servidor: ' + dados.erro); return; }
        receberDados(dados);
      })
      .withFailureHandler(function(err) {
        clearTimeout(timer);
        mostrarErro('Falha: ' + (err.message || String(err)));
      })
      .getDados();
  } else {
    receberDados(dadosDemo());
  }
};

function dadosDemo() {
  return {
    gerado: new Date().toLocaleString('pt-BR'),
    atores: [
      {timestamp:'01/07/2025',municipio:'Caxias do Sul',tipo:'IES',area:'Tecnologia',ecossistema:'Serra'},
      {timestamp:'02/07/2025',municipio:'Bento Gonçalves',tipo:'Empresa',area:'Agroindústria',ecossistema:'Uva e Vinho'},
      {timestamp:'03/07/2025',municipio:'Farroupilha',tipo:'Governo',area:'Saúde',ecossistema:'Serra'},
      {timestamp:'04/07/2025',municipio:'Caxias do Sul',tipo:'OSC',area:'Educação',ecossistema:'Hortifrutigranjeiro'},
      {timestamp:'05/07/2025',municipio:'Garibaldi',tipo:'Empresa',area:'Tecnologia',ecossistema:'Uva e Vinho'}
    ],
    projetos: [
      {timestamp:'01/07/2025',nome:'Plataforma AgriTech Serra',proponente:'UCS',area:'Agroindústria',estagio:'Desenvolvimento',municipio:'Caxias do Sul'},
      {timestamp:'02/07/2025',nome:'Hub de Inovação Bento',proponente:'Prefeitura BG',area:'Tecnologia',estagio:'Ideação',municipio:'Bento Gonçalves'}
    ]
  };
}

/* ============================================================
   RECEBER DADOS
   ============================================================ */
function receberDados(dados) {
  DADOS = dados;
  // Pré-popular mapa de cores de ecossistemas
  var ecoList = uniq((dados.atores||[]).map(function(v){return v.ecossistema;}).filter(Boolean));
  ecoList.forEach(function(e){ corEco(e); });

  setText('txt-atualizado', 'Atualizado: ' + dados.gerado);
  popularSelects(dados.atores, dados.projetos);
  renderVisao(dados.atores, dados.projetos);
  renderTabelaAtores(dados.atores);
  renderTabelaProjetos(dados.projetos);
  ['visao','atores','proj'].forEach(function(s) {
    g('load-'+s).style.display = 'none';
    g('content-'+s).style.display = '';
  });
  renderProjCharts(dados.projetos);
  renderVennCidade();
}

function renderProjCharts(pr) {
  var tc = DARK ? '#aaa' : '#666';
  var gc = DARK ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.05)';
  mkChart('c-areas-proj', 'bar',      contar(pr,'area'),    tc, gc, true);
  mkChart('c-estagios',   'doughnut', contar(pr,'estagio'), tc, gc, false);
}

function mostrarErro(msg) {
  var html = '<div class="erro-box">' + msg + '</div>';
  ['load-visao','load-atores','load-proj'].forEach(function(id) {
    var el = g(id); if (el) el.innerHTML = html;
  });
}

/* ============================================================
   SELECTS
   ============================================================ */
function popularSelects(at, pr) {
  var ecos  = uniq(at.map(function(v){return v.ecossistema;}).concat(pr.map(function(v){return v.ecossistema||'';})));
  var anos  = uniq(at.map(function(v){return ano(v.timestamp);}).concat(pr.map(function(v){return ano(v.timestamp);}))).filter(Boolean).sort().reverse();
  var cids  = uniq(at.map(function(v){return v.municipio;}).concat(pr.map(function(v){return v.municipio;}))).sort();
  pSel('sel-eco',ecos); pSel('sel-ano',anos); pSel('sel-cidade',cids);
  popularVennSelect(cids);
  popularVennSelect(cids.sort());
}
function pSel(id, vals) {
  var s = g(id); if (!s) return;
  var p = s.options[0]; s.innerHTML = ''; s.appendChild(p);
  vals.forEach(function(v) { if (!v) return; var o = document.createElement('option'); o.value = o.textContent = v; s.appendChild(o); });
}
function aplicarFiltros() {
  if (!DADOS) return;
  var at = fLista(DADOS.atores), pr = fLista(DADOS.projetos);
  destruir(); renderVisao(at, pr);
  renderTabelaAtores(at); renderTabelaProjetos(pr);
}
function fLista(lista) {
  var eco = g('sel-eco').value, an = g('sel-ano').value, cid = g('sel-cidade').value;
  return lista.filter(function(r) {
    return (!eco||(r.ecossistema||'')=== eco) && (!an||ano(r.timestamp)===an) && (!cid||(r.municipio||'')=== cid);
  });
}

/* ============================================================
   VISÃO GERAL
   ============================================================ */
function renderVisao(at, pr) {
  var munis = uniq(at.map(function(v){return v.municipio;}).filter(Boolean));
  var ecos  = uniq(at.map(function(v){return v.ecossistema;}).filter(Boolean));
  setText('k-atores', at.length);
  setText('k-munis',  munis.length);
  setText('k-proj',   pr.length);
  setText('k-ecos',   ecos.length);
  setText('k-atores-sub', uniq(at.map(function(v){return v.tipo;}).filter(Boolean)).length + ' tipos');
  setText('k-munis-sub',  ecos.length + ' ecossistemas');
  setText('k-proj-sub',   uniq(pr.map(function(v){return v.area;}).filter(Boolean)).length + ' áreas temáticas');
  setText('k-ecos-sub',   uniq(pr.map(function(v){return v.municipio;}).filter(Boolean)).length + ' municípios c/ projetos');

  var tc = DARK ? '#aaa' : '#666';
  var gc = DARK ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.05)';
  mkChart('c-tipos',      'bar',      contar(at,'tipo'),    tc, gc, true);
  mkChart('c-areas-at',   'doughnut', contar(at,'area'),    tc, gc, false);
  // gráficos de projetos renderizados na própria aba — ver renderProjCharts()

  // Barras de ecossistema com cores próprias
  hbarEco('hbars-ecos', contar(at,'ecossistema'));
  hbar('hbars-cidades', top10(contar(at,'municipio')));
}

/* ============================================================
   TABELAS
   ============================================================ */
function renderTabelaAtores(lista) {
  var tb = g('tbody-atores'), em = g('empty-atores');
  setText('cnt-atores', lista.length + ' registros');
  if (!lista.length) { tb.innerHTML = ''; em.style.display = ''; return; }
  em.style.display = 'none';
  tb.innerHTML = lista.map(function(a,i) {
    return '<tr><td class="muted">'+(i+1)+'</td><td><strong>'+e(a.empresa||'—')+'</strong></td><td>'+bTipo(a.tipo)+'</td>'
      +'<td>'+e(a.municipio)+'</td><td>'+bEco(a.ecossistema)+'</td></tr>';
  }).join('');
}

function renderTabelaProjetos(lista) {
  var tb = g('tbody-proj'), em = g('empty-proj');
  setText('cnt-proj', lista.length + ' registros');
  if (!lista.length) { tb.innerHTML = ''; em.style.display = ''; return; }
  em.style.display = 'none';
  tb.innerHTML = lista.map(function(p,i) {
    return '<tr><td class="muted">'+(i+1)+'</td>'
      +'<td style="max-width:240px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="'+e(p.nome)+'"><strong>'+e(p.nome)+'</strong></td>'
      +'<td>'+e(p.proponente)+'</td><td>'+e(p.area)+'</td><td>'+bEst(p.estagio)+'</td>'
      +'<td>'+e(p.municipio)+'</td><td class="muted">'+e(p.timestamp)+'</td></tr>';
  }).join('');
}

/* ============================================================
   GRÁFICOS
   ============================================================ */
function mkChart(id, tipo, obj, tc, gc, horiz) {
  if (CHARTS[id]) CHARTS[id].destroy();
  var ctx = g(id); if (!ctx) return;
  var lbls = Object.keys(obj), vals = Object.values(obj);
  var isDo = tipo === 'doughnut';
  var bg = lbls.map(function(_,i) { return CORES[i % CORES.length]; });
  CHARTS[id] = new Chart(ctx, {
    type: tipo,
    data: { labels: lbls, datasets: [{ data: vals, backgroundColor: bg, borderWidth: isDo ? 0 : 1, borderColor: '#fff' }] },
    options: {
      indexAxis: horiz ? 'y' : 'x', responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: isDo, position: 'right', labels: { font: { size: 12 }, boxWidth: 12, padding: 10, color: tc } } },
      scales: isDo ? {} : {
        x: { ticks: { font: { size: 11 }, color: tc }, grid: { color: gc } },
        y: { ticks: { font: { size: 11 }, color: tc }, grid: { color: gc } }
      }
    }
  });
}
function destruir() { Object.keys(CHARTS).forEach(function(k) { if (CHARTS[k]) CHARTS[k].destroy(); }); CHARTS = {}; }

function hbarEco(id, obj) {
  var w = g(id); if (!w) return; w.innerHTML = '';
  var mx = Math.max.apply(null, Object.values(obj)) || 1;
  Object.keys(obj).forEach(function(k) {
    var pct = Math.round(obj[k] / mx * 100);
    var cor = corEco(k);
    var d = document.createElement('div'); d.className = 'hbar-row';
    d.innerHTML = '<span class="hbar-lbl">' + (k||'(sem info)') + '</span>'
      +'<div class="hbar-track"><div class="hbar-fill" style="width:'+pct+'%;background:'+cor+'">'
      +'<span class="hbar-num">'+obj[k]+'</span></div></div>';
    w.appendChild(d);
  });
}
function hbar(id, obj) {
  var w = g(id); if (!w) return; w.innerHTML = '';
  var mx = Math.max.apply(null, Object.values(obj)) || 1;
  Object.keys(obj).forEach(function(k, i) {
    var pct = Math.round(obj[k] / mx * 100);
    var d = document.createElement('div'); d.className = 'hbar-row';
    d.innerHTML = '<span class="hbar-lbl">' + (k||'(sem info)') + '</span>'
      +'<div class="hbar-track"><div class="hbar-fill" style="width:'+pct+'%;background:'+CORES[i%CORES.length]+'">'
      +'<span class="hbar-num">'+obj[k]+'</span></div></div>';
    w.appendChild(d);
  });
}

/* ============================================================
   NAVEGAÇÃO
   ============================================================ */
function abrirPainel(aba) {
  g('capa').style.display = 'none';
  g('painel').style.display = 'block';
  document.querySelectorAll('.nav-tab').forEach(function(b) { b.classList.remove('on'); });
  document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('on'); });
  var cls = aba === 'visao' ? 'verde' : aba === 'atores' ? 'verm' : 'amare';
  var btn = document.querySelector('.nav-tab.'+cls); if (btn) btn.classList.add('on');
  var tc  = g('tab-'+aba); if (tc) tc.classList.add('on');
}
function voltarCapa() { g('painel').style.display = 'none'; g('capa').style.display = ''; }
function abaTab(id, btn) {
  document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.remove('on'); });
  document.querySelectorAll('.nav-tab').forEach(function(b) { b.classList.remove('on'); });
  g('tab-'+id).classList.add('on'); btn.classList.add('on');
}
function toggleDark() {
  DARK = !DARK;
  document.documentElement.setAttribute('data-dark', DARK ? '1' : '0');
  g('btn-dark').textContent = DARK ? '☀️ Claro' : '🌙 Escuro';
  destruir();
  if (DADOS) { renderVisao(fLista(DADOS.atores), fLista(DADOS.projetos)); }
}

/* ============================================================
   BADGES
   ============================================================ */
function bEco(nome) {
  var cor = corEco(nome || 'Outro');
  return '<span class="eco-badge" style="background:'+cor+'">'+e(nome||'—')+'</span>';
}
function bTipo(t) {
  var s = (t||''). toLowerCase();
  var c = s.includes('ies')||s.includes('universidade')||s.includes('faculdade') ? 'badge-purple'
        : s.includes('empresa')||s.includes('privada') ? 'badge-blue'
        : s.includes('governo')||s.includes('publi')||s.includes('prefeitura') ? 'badge-amber'
        : s.includes('osc')||s.includes('associa')||s.includes('terceiro') ? 'badge-green'
        : 'badge-gray';
  return '<span class="badge '+c+'">'+e(t||'—')+'</span>';
}
function bEst(t) {
  var s = (t||''). toLowerCase();
  var c = s.includes('idea') ? 'badge-purple'
        : s.includes('desenvolv') ? 'badge-blue'
        : s.includes('piloto') ? 'badge-amber'
        : s.includes('consolid')||s.includes('escala') ? 'badge-green'
        : 'badge-gray';
  return '<span class="badge '+c+'">'+e(t||'—')+'</span>';
}

/* ============================================================
   UTILS
   ============================================================ */
function g(id) { return document.getElementById(id); }
function setText(id, v) { var el = g(id); if (el) el.textContent = v; }
function e(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function uniq(arr) { var s={},o=[]; arr.forEach(function(v){ if(v&&!s[v]){s[v]=1;o.push(v);} }); return o; }
function ano(s) { if(!s) return ''; var m=String(s).match(/(\d{4})/); return m?m[1]:''; }
function contar(arr, campo) {
  var o = {};
  arr.forEach(function(r) { var v=r[campo]||'(sem info)'; o[v]=(o[v]||0)+1; });
  var s = {};
  Object.keys(o).sort(function(a,b){ return o[b]-o[a]; }).forEach(function(k){ s[k]=o[k]; });
  return s;
}
function top10(obj) { var s={}; Object.keys(obj).slice(0,10).forEach(function(k){ s[k]=obj[k]; }); return s; }

/* ============================================================
   MAPEAMENTO AUTOMÁTICO DE VOCAÇÕES
   ============================================================ */
var VOCACAO_MAP = [
  {k:['metalm','metal mecân','metalmecân'],         v:['I']},
  {k:['eletroelet','eletroelêtr','eletrôn','eletron'], v:['I']},
  {k:['plástic','plastic','polím','polim'],          v:['I']},
  {k:['movelei','móveis','moveis','furniture'],      v:['I']},
  {k:['têxtil','textil','confec','moda'],            v:['I']},
  {k:['automotiv'],                                  v:['I','E']},
  {k:['agroindu'],                                   v:['I','T']},
  {k:['agrícol','agricol','agropec'],                v:['I','T']},
  {k:['agroneg'],                                    v:['I','T']},
  {k:['turismo','hotel','hosped','pousada','receptiv','hospit'], v:['T']},
  {k:['gastrono','restaur','alimentaç','aliment','culinár'],    v:['T']},
  {k:['vinho','uva','vinícol','viticult','enológ','enolog','cervej'], v:['T']},
  {k:['ecológ','ecolog','ecoturis','ecotur'],        v:['T']},
  {k:['esport','aventur','radical','lazer'],         v:['T']},
  {k:['cultural','cultura','arte','criat','museu'],  v:['T','I']},
  {k:['educaç','educac','escola','ensino','aprendiz','academ','univ','facul','instit'], v:['E']},
  {k:['pesquis','científ','cientif','p&d','laboratór','laborator'], v:['E']},
  {k:['capacit','treinamento','qualific','formação','formacao'],   v:['E']},
  {k:['robótic','robotic','mecatrôn','mecatron','automação','automacao'], v:['I','E']},
  {k:['tecnolog','tech','software','startup','digital','ti ','t.i'],      v:['I','E']},
  {k:['saúde','saude','health','médic','medic','hospital','clínic','clinc'], v:['I','E','T']},
  {k:['sustentab','ambient','energi','green'],       v:['I']},
  {k:['mobilidade','smart','cidade intelig','logíst','logist'], v:['I','T','E']},
  {k:['inovaç','inovac','hub','incubad','acelerador'],           v:['I','E']},
  {k:['financ','crédit','fomento','invest','banco','cooperativ'], v:['I','E']},
  {k:['governo','prefeit','secretar','público','publico'],        v:['I','T','E']},
  {k:['associaç','associac','sindicato','federaç','federac'],     v:['I','T','E']},
  {k:['comunicaç','comunicac','mídia','midia','market'],          v:['T','I']}
];

function getVocacoes(ator) {
  var s = ((ator.segmento||'') + ' ' + (ator.tipo||'')).toLowerCase();
  var cats = {};
  VOCACAO_MAP.forEach(function(m) {
    m.k.forEach(function(kw) {
      if (s.indexOf(kw) !== -1) m.v.forEach(function(v){ cats[v]=true; });
    });
  });
  var res = Object.keys(cats);
  return res.length > 0 ? res : ['I'];
}

function popularVennSelect(cids) {
  var s = g('sel-venn-cidade'); if (!s) return;
  var p = s.options[0]; s.innerHTML = ''; s.appendChild(p);
  cids.forEach(function(v) { if (!v) return; var o=document.createElement('option'); o.value=o.textContent=v; s.appendChild(o); });
}

function renderVennCidade() {
  var cidade = g('sel-venn-cidade') ? g('sel-venn-cidade').value : '';
  var atores = cidade
    ? (DADOS ? DADOS.atores : []).filter(function(a){ return a.municipio===cidade; })
    : (DADOS ? DADOS.atores : []);

  var reg = {I:0,T:0,E:0,IT:0,IE:0,TE:0,ITE:0};
  atores.forEach(function(a) {
    var cats = getVocacoes(a);
    var hasI = cats.indexOf('I')>=0, hasT = cats.indexOf('T')>=0, hasE = cats.indexOf('E')>=0;
    if (hasI&&hasT&&hasE) reg.ITE++;
    else if (hasI&&hasT)  reg.IT++;
    else if (hasI&&hasE)  reg.IE++;
    else if (hasT&&hasE)  reg.TE++;
    else if (hasI)        reg.I++;
    else if (hasT)        reg.T++;
    else if (hasE)        reg.E++;
  });

  var tot = atores.length;
  var tit = cidade ? cidade : 'Todos os municípios';
  g('venn-container').innerHTML = buildVennSVG(reg, tit, tot);
}

function buildVennSVG(r, titulo, total) {
  // Posições dos círculos
  var cx1=175, cy1=165, // Indústria 4.0
      cx2=325, cy2=165, // Turismo
      cx3=250, cy3=290, // Educação
      rad=115;

  function num(n) { return n > 0 ? String(n) : ''; }
  function lbl(x,y,n,fill,sz) {
    if (n===0) return '';
    sz = sz||20;
    return '<text x="'+x+'" y="'+y+'" text-anchor="middle" dominant-baseline="middle" font-size="'+sz+'" font-weight="900" fill="'+fill+'">'+n+'</text>';
  }

  // Cores baseadas no diagrama de referência
  var cI   = '#2196B3'; // azul/teal – Indústria 4.0
  var cT   = '#E53935'; // vermelho  – Turismo
  var cE   = '#43A047'; // verde     – Educação Tecnológica

  return '<svg viewBox="0 0 500 450" width="460" style="max-width:100%;">'
    +'<circle cx="'+cx1+'" cy="'+cy1+'" r="'+rad+'" fill="rgba(33,150,179,0.28)" stroke="'+cI+'" stroke-width="2"/>'
    +'<circle cx="'+cx2+'" cy="'+cy2+'" r="'+rad+'" fill="rgba(229,57,53,0.28)"  stroke="'+cT+'" stroke-width="2"/>'
    +'<circle cx="'+cx3+'" cy="'+cy3+'" r="'+rad+'" fill="rgba(67,160,71,0.28)"  stroke="'+cE+'" stroke-width="2"/>'
    // Rótulos
    +'<text x="100" y="42" text-anchor="middle" font-size="12" font-weight="800" fill="'+cI+'">INDÚSTRIA 4.0</text>'
    +'<text x="400" y="42" text-anchor="middle" font-size="12" font-weight="800" fill="'+cT+'">TURISMO</text>'
    +'<text x="250" y="430" text-anchor="middle" font-size="12" font-weight="800" fill="'+cE+'">EDUCAÇÃO TECNOLÓGICA</text>'
    // Contagens
    + lbl(100, 165, r.I,   cI,       22)
    + lbl(400, 165, r.T,   cT,       22)
    + lbl(250, 378, r.E,   cE,       22)
    + lbl(250, 118, r.IT,  '#7B1FA2',18)  // roxo – I∩T
    + lbl(185, 255, r.IE,  '#00695C',18)  // verde-escuro – I∩E
    + lbl(315, 255, r.TE,  '#BF360C',18)  // laranja-escuro – T∩E
    + lbl(250, 210, r.ITE, '#4E342E',22)  // marrom escuro centro – I∩T∩E
    +'</svg>'
    +'<p style="text-align:center;font-size:12px;color:var(--text3);margin-top:16px;font-weight:500;">'+total+' atores · '+titulo+'</p>';
}


function toggleVocacoesTexto() {
  var box = g('vocacoes-texto');
  var arrow = g('venn-arrow');
  if (!box) return;
  var open = box.style.display !== 'none';
  box.style.display = open ? 'none' : 'block';
  if (arrow) arrow.style.transform = open ? '' : 'rotate(180deg)';
}


